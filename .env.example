
# Local SQLite file (default). For hosting, use a free Turso database URL like libsql://roadrescue-yourname.turso.io
DATABASE_URL=file:./data/roadrescue.db
# Only needed for a hosted Turso database
DATABASE_AUTH_TOKEN=

# Secret used to sign login sessions. REQUIRED in production. Make a long random string, e.g. run:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
