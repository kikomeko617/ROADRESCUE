{
  "name": "roadrescue",
  "version": "1.1.0",
  "private": true,
  "description": "ROADRESCUE - on-demand roadside mechanic marketplace (MGT3151 E-Commerce prototype, UCU)",
  "type": "module",
  "scripts": {
    "predev": "node scripts/db-setup.mjs --if-missing",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:setup": "node scripts/db-setup.mjs",
    "db:reset": "node scripts/db-setup.mjs --reset",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "test": "vitest run",
    "test:report": "vitest run --reporter=verbose --reporter=junit --outputFile.junit=test-evidence/test-results.xml",
    "test:e2e": "node scripts/e2e-walkthrough.mjs http://localhost:3000",
    "test:a11y": "node scripts/a11y-check.mjs http://localhost:3000"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@libsql/client": "0.15.15",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "3.0.2",
    "dotenv": "16.4.7",
    "jose": "6.0.13",
    "leaflet": "1.9.4",
    "next": "15.5.28",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "vitest": "3.2.6"
  }
}
